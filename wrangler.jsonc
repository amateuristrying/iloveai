// Cloudflare Workers (static assets) — `npm run deploy`, or connect the repo in
// the Cloudflare dashboard with build command `npm run build` and deploy command
// `npx wrangler deploy`. For Cloudflare Pages instead: build `npm run build`, output `dist`.
{
  "name": "ai-loves-us",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
